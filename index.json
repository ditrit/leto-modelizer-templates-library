{
  "name": "Leto-modelizer-templates-library",
  "version": "0.1.0",
  "description": "Library that contains all default templates for leto-modelizer.",
  "maintainer": "Vincent Moittie <moittie.vincent@gmail.com>",
  "icon": "templates/terraform_aws_provider/icon.svg",
  "templates": [
    {
      "name": "Web application",
      "type": "DIAGRAM",
      "description": "Schema of web application.",
      "basePath": "templates/terraform_webapp/",
      "plugin": "@ditrit/terrator-plugin",
      "icon": "icon.svg",
      "schemas": ["schema.svg"],
      "files": ["main.tf"]
    },
    {
      "name": "Java web application",
      "type": "DIAGRAM",
      "description": "Schema of java web application.",
      "basePath": "templates/terraform_java_webapp/",
      "plugin": "@ditrit/terrator-plugin",
      "icon": "icon.svg",
      "schemas": ["schema.svg"],
      "files": ["main.tf"]
    },
    {
      "name": "Default CI",
      "type": "DIAGRAM",
      "description": "GITHUB",
      "basePath": "templates/templates/github_CI/",
      "plugin": "@ditrit/githubator-plugin",
      "icon": "icon.svg",
      "schemas": ["schema.svg"],
      "files": ["CI.yml"]
    },
    {
      "name": "Aws provider",
      "type": "COMPONENT",
      "description": "Initialized aws provider.",
      "basePath": "templates/terraform_aws_provider/",
      "plugin": "@ditrit/terrator-plugin",
      "icon": "icon.svg",
      "schemas": ["schema.svg"],
      "files": ["provider.tf"]
    },
    {
      "name": "Test application",
      "type": "COMPONENT",
      "description": "Initialized test application.",
      "basePath": "templates/terraform_test_application/",
      "plugin": "@ditrit/terrator-plugin",
      "icon": "icon.svg",
      "schemas": ["schema.svg"],
      "files": ["app.tf"]
    },
    {
      "name": "Project template",
      "type": "PROJECT",
      "description": "Project template example.",
      "basePath": "templates/project_template/",
      "plugins": ["@ditrit/terrator-plugin", "@ditrit/githubator-plugin"],
      "icon": "icon.svg",
      "schemas": [
        "schema_model1.svg",
        "schema_model2.svg",
        "schema_model3.svg"
      ],
      "files": [
        ".github/workflows/CI.yml",
        "infra/dev/main.tf",
        "infra/dev/provider.tf",
        "infra/prod/main.tf"
      ]
    }
  ]
}
